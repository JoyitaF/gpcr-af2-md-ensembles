font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 8
axes.labelsize: 8.5
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.edgecolor: 4d4d4d
axes.axisbelow: True
axes.grid: True
axes.grid.axis: y
grid.color: e1e1e1
grid.linewidth: 0.5
xtick.direction: out
ytick.direction: out
xtick.labelsize: 7.5
ytick.labelsize: 7.5
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.major.width: 0.6
ytick.major.width: 0.6
legend.fontsize: 7.5
legend.frameon: False
pdf.fonttype: 42
savefig.dpi: 300
savefig.facecolor: white
